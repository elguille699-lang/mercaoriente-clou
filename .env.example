# Servicio que ejecuta el contenedor: gateway | broker | inventario | pedidos | notificaciones
SERVICE=gateway

# Puerto de escucha del servicio
PORT=8080

# Ubicación de los demás servicios (Configuración externa)
BROKER_URL=http://localhost:4000
INVENTARIO_URL=http://localhost:4001
PEDIDOS_URL=http://localhost:4002
NOTIFICACIONES_URL=http://localhost:4003

# URL pública con la que el servicio de notificaciones se registra en el broker
NOTIFICACIONES_CALLBACK_URL=http://localhost:4003/eventos

# Resiliencia del servicio de pedidos frente a inventario
CB_UMBRAL_FALLOS=3
CB_TIEMPO_ABIERTO_MS=15000
REINTENTOS_INVENTARIO=3

# Límite de solicitudes por minuto y por IP en el API Gateway
LIMITE_SOLICITUDES_MINUTO=120
